# Private working material. Keep this out of every published branch.
/local-only/

# Existing local collections remain in place while verifier inputs are curated.
# Do not move these directories without updating their consumers first.
/research/
/artifacts/
/output/
/experiments/*/evidence/
/experiments/*/provenance/
/experiments/*/pkg/

# Generated files and host-local state.
**/target/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.venv/
/.playwright-cli/
.DS_Store

# Local credentials; example environment files can be reviewed for publication.
.env
.env.*
!.env.example
!.env.sample

# Generated exact allowlist for public verifier inputs; other local material stays ignored.
/research/**
/artifacts/**
/experiments/*/provenance/**
/experiments/*/evidence/**
