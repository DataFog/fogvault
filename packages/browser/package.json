{
  "name": "@datafog/fogvault-browser",
  "version": "0.1.0",
  "private": false,
  "description": "FogVault Rust/WASM SDK with owned Workers and IndexedDB storage",
  "license": "MIT",
  "type": "module",
  "main": "./dist/client.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/client.mjs"
    },
    "./worker": "./dist/worker.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/client.test.mjs",
    "test:extensions": "playwright test test/extensions.spec.mjs --workers=1",
    "test:types": "tsc --noEmit --strict --module nodenext --target es2022 --lib es2022,dom test/types.ts"
  },
  "devDependencies": {
    "playwright": "1.64.0-alpha-1790635538000",
    "web-ext": "10.8.0",
    "@playwright/test": "1.64.0-alpha-1790635538000",
    "typescript": "7.0.2",
    "@playwright/cli": "0.1.22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DataFog/fogvault.git"
  }
}
