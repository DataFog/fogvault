{
  "manifest_version": 3,
  "name": "FogVault SDK example",
  "version": "0.0.0",
  "description": "Synthetic vault integration in a privileged extension page",
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open FogVault example"},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}
}
